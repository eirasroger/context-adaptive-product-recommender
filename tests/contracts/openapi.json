  "info": {
    "description": "Inference API.\n\nSubmit a shortlist and a context, receive a score per alternative. The response\nalways echoes the category's declared eligibility precondition, because the\nmodel ranks options that are assumed to have already passed regulatory\nprefiltering and saying so is the difference between a recommendation and a\ncompliance claim.\n\nThe registry comes from the checkpoint, not from the live database, so the\nserved semantics are exactly the ones the weights were trained under.\n",
    "title": "Context-adaptive product recommender",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/categories": {
      "get": {
        "description": "What can be compared, and what each category assumes about its input.",
        "operationId": "categories_api_categories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Categories Api Categories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Categories"
      }
    },

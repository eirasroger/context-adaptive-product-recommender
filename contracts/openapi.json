              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Form",
        "tags": [
          "explore"
        ]
      }
    },
    "/api/explore/response": {
      "get": {
        "operationId": "response",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": true,
            "schema": {
              "title": "Category",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "indicator",
            "required": true,
            "schema": {
              "title": "Indicator",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "context",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Context"
            }
          },
          {
            "in": "query",
            "name": "stakeholders",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stakeholders"
            }
          },
          {
            "in": "query",
            "name": "steps",
            "required": false,
            "schema": {
              "default": 21,
              "title": "Steps",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Response",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Response",
        "tags": [
          "explore"
        ]
      }
    },

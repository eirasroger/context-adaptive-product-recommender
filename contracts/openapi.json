  "info": {
    "description": "Inference API.\n\nSubmit a shortlist and a context, receive a score per alternative. Every\nresponse echoes the category's eligibility precondition: the model ranks\noptions assumed to have passed regulatory checks.\n",
    "title": "Context-adaptive product recommender",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/categories": {
      "get": {
        "description": "What can be compared, and what each category assumes about its input.",
        "operationId": "categories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Categories",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Categories"
      }
    },
    "/api/categories/{category_key}/indicators": {
      "get": {
        "operationId": "indicators",
        "parameters": [
          {
            "in": "path",
            "name": "category_key",
            "required": true,
            "schema": {
              "title": "Category Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Indicators",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Indicators"
      }
    },
    "/api/explore/compare": {
      "post": {
        "description": "Why the leading alternative is ahead of each of the others.",
        "operationId": "compare",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortlistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comparison"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compare",
        "tags": [
          "explore"
        ]
      }
    },
    "/api/explore/context-sensitivity": {
